# 로컬 개발용 env. 이 파일을 복사해 `.env` 또는 `.env.local` 로 만들어 쓴다.
# - Next.js·drizzle-kit 모두 .env.local → .env 순으로 읽는다 (.env.local 이 우선).
# - .env* 는 .gitignore 대상. 운영 값은 절대 개발 머신에 두지 않는다 (Vercel 환경변수에서만 관리).
#
# ─────────────────────────────────────────────────────────────
# 방법 A (권장): 개발용 Supabase 프로젝트에 붙는다 — Docker 불필요, 운영과 동일 동작
# ─────────────────────────────────────────────────────────────
#   1) supabase 프로젝트 두 개 중 "개발용"(예: ref rhayjzneuvaayervloki) 을 쓴다
#   2) 로컬 repo 를 개발 프로젝트에 링크:  npx supabase link --project-ref <개발 ref>
#   3) 스키마 적용:                        npx supabase db push
#   4) 아래 값을 채운다 (키·URL 은 대시보드 Settings → API, 또는
#      npx supabase projects api-keys --project-ref <개발 ref>)
#
NEXT_PUBLIC_SUPABASE_URL=https://<개발-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<개발 프로젝트 anon / publishable key>
# 앱은 Drizzle 로 DB 에 직결한다. 원격은 반드시 커넥션 풀러(6543, Supavisor)를 쓴다.
DATABASE_URL=postgresql://postgres.<개발-ref>:<개발 DB 비밀번호>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ─────────────────────────────────────────────────────────────
# 방법 B: 로컬 Supabase 스택 (npm run db:start, Docker 필요)
# ─────────────────────────────────────────────────────────────
# 아래 값은 `supabase start` 출력에 그대로 찍힌다. anon key 도 로컬 고정값이라 공개돼도 무방.
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase start 출력의 anon key>
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─────────────────────────────────────────────────────────────
# 메일 발송 (Resend) — 가입 완료 안내 메일 (src/lib/email.ts)
# ─────────────────────────────────────────────────────────────
# 이메일 확인(enable_confirmations)을 꺼서 가입 즉시 진입시키므로, "가입 완료" 메일은
# 앱이 Resend API 로 직접 보낸다. 미설정 시 메일만 조용히 skip되고 가입은 정상 동작.
#   - RESEND_API_KEY : https://resend.com → API Keys
#   - EMAIL_FROM     : Resend 에 인증된 도메인의 발신 주소여야 실제 발송됨
#                      (미인증 도메인이면 onboarding@resend.dev 로 본인 계정에만 테스트 발송 가능)
# 운영 값은 Vercel + GitHub Actions 환경변수에서만 관리한다.
RESEND_API_KEY=<resend api key>
EMAIL_FROM=맞춤 스킨케어 <no-reply@yourdomain.com>
